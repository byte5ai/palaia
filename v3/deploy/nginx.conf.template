# Rendered by entrypoint.sh (envsubst) into a writable path at container
# start — never edited in place inside the image. A full standalone
# nginx.conf (not a Debian sites-enabled snippet) so the container doesn't
# depend on nginx-light's packaged defaults.
#
# Role: the ONE public entry point. Serves the built dashboard as static
# files and reverse-proxies API/MCP traffic to the hub process, which binds
# only to loopback inside the container.

worker_processes 1;
pid /tmp/nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    client_body_temp_path /tmp/nginx/body;
    proxy_temp_path /tmp/nginx/proxy;
    fastcgi_temp_path /tmp/nginx/fastcgi;
    uwsgi_temp_path /tmp/nginx/uwsgi;
    scgi_temp_path /tmp/nginx/scgi;

    server {
        listen ${PUBLIC_PORT};
        server_name _;

        # Everything the hub owns today (SPEC-101: /api/health, /api/info;
        # SPEC-105 onward: the MCP mount point) is proxied straight through.
        # Kept as one generic prefix rather than an enumerated list so later
        # SPECs adding routes under /api or /mcp don't need a packaging
        # change.
        #
        # SPEC-502 finding: `/oauth` and `/.well-known` were missing from
        # this list, which predates the authorization server (SPEC-203).
        # In the packaged image that meant the sign-in page, the OAuth
        # endpoints and the discovery documents all fell through to the
        # static dashboard below and answered with the SPA shell — so no
        # MCP client could complete an OAuth flow against the image, and in
        # `open` mode (where signing in is mandatory) the operator could
        # not reach the one door into their own hub.
        #
        # Issue #439: `/telegram` too — Telegram's webhook deliveries
        # (`POST /telegram/webhook/<bot>`). Without it a webhook bot on the
        # packaged image would reach the static location below instead of
        # the hub, and never be delivered. The route is authenticated by
        # Telegram's secret-token header, checked by the hub itself.
        location ~ ^/(api|mcp|oauth|telegram|\.well-known)(/|$) {
            proxy_pass http://${PALAIA_HOST}:${PALAIA_PORT};
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # MCP streaming responses (SSE-style) must not be buffered.
            proxy_buffering off;
            # The hub's /api/events stream sends a comment frame every 15 s
            # while idle (palaia_hub.events.bus, issue #400), so this
            # timeout is never reached by a quiet dashboard.
            proxy_read_timeout 300s;
            # MCP tool payloads can exceed nginx's 1 MB default body cap.
            client_max_body_size 16m;
        }

        # Static dashboard (SPA). Falls back to index.html for client-side
        # routing; index.html itself is never cached so a new image always
        # serves the current build's asset references.
        root /opt/palaia/dashboard;

        # SPEC-502: the same browser-hardening headers the hub sets on the
        # responses it serves itself (palaia_hub.security.headers). nginx
        # serves the dashboard's static files without ever reaching the hub
        # process, so without these the one surface a browser actually
        # renders in the packaged image would be the only one with no
        # policy on it. Kept byte-identical to DASHBOARD_CSP in that module.
        #
        # Set inside the two static locations, not at server level (issue
        # #400): a server-level `add_header` inherits into every location
        # that declares none — the proxy block above — so /api, /mcp,
        # /oauth and /.well-known responses carried the dashboard policy a
        # second time next to the hub's own API/OAuth-page policy, and any
        # future relaxation of the hub's policy would have been silently
        # overridden by packaging.

        location = /index.html {
            # `add_header` does not inherit into a block that declares one
            # of its own, so the set is repeated here (and in `location /`)
            # rather than silently dropped for the one file every visit fetches.
            add_header Cache-Control "no-cache";
            add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "no-referrer" always;
            add_header X-Frame-Options "DENY" always;
            add_header Cross-Origin-Opener-Policy "same-origin" always;
            add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        }

        location / {
            try_files $uri $uri/ /index.html;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "no-referrer" always;
            add_header X-Frame-Options "DENY" always;
            add_header Cross-Origin-Opener-Policy "same-origin" always;
            add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        }
    }
}
