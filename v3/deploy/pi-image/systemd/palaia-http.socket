[Unit]
Description=palaia: answer on port 80 (forwarded to the hub on 8420)
Documentation=https://github.com/byte5ai/palaia/blob/main/v3/deploy/pi-image/README.md
# Issue #620: http://palaia.local/ without a port. The hub container keeps
# its hardening (non-root, every capability dropped), so it cannot bind a
# port below 1024 itself; this socket does, outside the container, and
# palaia-http.service forwards what arrives to the hub's own port 8420 —
# the same split OctoPi uses (OctoPrint on 5000, port 80 in front of it).
#
# Started after the rest of the boot, not with the early sockets: a web
# server the owner installed on this box (nginx, lighttpd, Pi-hole, …)
# binds port 80 first and keeps it; this socket then fails on its own and
# the hub stays reachable on 8420. DefaultDependencies=no is what makes the
# ordering after multi-user.target legal (the target then does not order
# itself after this unit); the lines below restore the default ones this
# unit still needs.
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target network.target multi-user.target
Conflicts=shutdown.target
Before=shutdown.target
# Deliberately no Requires=/BindsTo=/PartOf= on palaia.service, in either
# direction: neither unit failing may take the other down.

[Socket]
ListenStream=80

[Install]
WantedBy=multi-user.target
