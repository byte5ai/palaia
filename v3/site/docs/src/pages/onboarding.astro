---
// SPEC-504 deliverable #1: the onboarding page — English (default).
//
// The page is localized into the languages the palaia.ai homepage offers
// (en/de/fr/es/it); the rest of the docs site stays English-only. This file is
// the English route at /onboarding; the others are generated by
// ./onboarding/[lang].astro. All of them render the shared <OnboardingBody>
// with a per-locale dictionary from ../i18n/onboarding/<lang>.json — so the
// markup, styles and copy script live once and only the words change.
//
// The visible English prose lives in en.json (linted by the server-side
// onboarding jargon test); the drift-tested install commands still come from
// scripts/lib/deploy-snippets.mjs inside <OnboardingBody>, which is also where
// the <style> block and the isPrerelease/`prerelease &&` gate live now.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import OnboardingBody from "../components/OnboardingBody.astro";
import t from "../i18n/onboarding/en.json";
---

<StarlightPage frontmatter={{
  title: t.meta.title,
  description: t.meta.description,
  template: "splash",
}}>
  <OnboardingBody t={t} lang="en" />
</StarlightPage>
