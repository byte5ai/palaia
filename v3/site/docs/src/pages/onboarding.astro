---
// SPEC-504 deliverable #1: the onboarding page. Rewritten (issue: onboarding
// too dev-heavy for the Home-Assistant audience) so the PRIMARY path is a
// plain, no-terminal "cloud server in three steps" — pick a provider, get a
// Tailscale key, paste the cloud-config, create the server — and Docker /
// Compose are demoted to a clearly-labelled "For developers" section. A
// third path covers a server the reader already has (cloud-init only runs on
// first boot, so an existing box is set up over SSH with the universal
// installer, `curl … get.palaia.ai | sh` — v3/deploy/get-palaia.sh).
//
// Same toolchain and theme as the rest of this site (Astro + Starlight, this
// project's `custom.css` tokens). `StarlightPage` (not a `src/content/docs/*`
// entry) because this page needs the copy buttons and the developer tab-panel
// — real interactivity a Markdown page's fixed layout does not fit — while
// still getting Starlight's header, theme toggle and search for free.
// `template: "splash"` drops the sidebar so it reads as a landing page.
//
// Every command below is read out of `v3/deploy`'s real files at build time
// (`scripts/lib/deploy-snippets.mjs`) — never retyped — which is what makes
// "the page's snippets match the real deploy files" true by construction.
// `tests/onboarding.test.ts` is the drift test: it independently re-reads the
// same source files and asserts the extracted snippets are exactly that text.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import {
  isPrerelease,
  loadCloudInitTemplate,
  loadDeploySnippets,
  loadGetPalaiaCommand,
} from "../../scripts/lib/deploy-snippets.mjs";

const snippets = loadDeploySnippets();
const cloudInit = loadCloudInitTemplate();
// During a release candidate the `stable` image does not exist yet; the dev
// commands below (read verbatim from v3/deploy) still name it, so the page
// carries the same `:beta` note deploy/README.md does — but only while
// v3/VERSION is a pre-release, gated here the same way that file's own note is.
const prerelease = isPrerelease();
// The `curl … get.palaia.ai | sh` one-liner, read from get-palaia.sh's header.
// The universal installer defaults to the `stable` channel; during a
// pre-release that image does not exist yet, so the shown command carries
// PALAIA_CHANNEL=beta until 3.0.0 is final, and is the bare command after.
const getPalaiaBase = loadGetPalaiaCommand();
const installCommand = prerelease
  ? getPalaiaBase.replace(/\|\s*sh\s*$/, "| PALAIA_CHANNEL=beta sh")
  : getPalaiaBase;

const STORES = [
  { name: "Umbrel", dir: "umbrel" },
  { name: "CasaOS", dir: "casaos" },
  { name: "Runtipi", dir: "runtipi" },
  { name: "TrueNAS SCALE", dir: "truenas" },
] as const;

const REPO = "https://github.com/byte5ai/palaia";
const TAILSCALE_KEYS_URL = "https://login.tailscale.com/admin/settings/keys";
// Site base, normalized without a trailing slash — prefix in-site links so
// they resolve under the base rather than at the domain root. Each link below
// adds its own leading slash. See astro.config.mjs.
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<StarlightPage frontmatter={{
  title: "Get palaia running",
  description: "The simple way is a small cloud server in three steps — no terminal. Developer options are here too.",
  template: "splash",
}}>
  <div class="op">
    <p class="op-lede">
      palaia lives on an always-on box that your AI tools reach from anywhere —
      a small cloud server, a NAS, a spare mini-PC. Pick how you want to run it:
    </p>

    <nav class="op-jump" aria-label="Ways to install">
      <a href="#cloud-server">
        <span class="op-jump-title">Cloud server</span>
        <span class="op-jump-sub">no terminal · paste one file</span>
      </a>
      <a href="#already-have-a-server">
        <span class="op-jump-title">Existing server</span>
        <span class="op-jump-sub">one command over SSH</span>
      </a>
      <a href="#your-own-machine">
        <span class="op-jump-title">Your own machine</span>
        <span class="op-jump-sub">Pi · NAS · Mac</span>
      </a>
      <a href="#for-developers">
        <span class="op-jump-title">Docker &amp; Compose</span>
        <span class="op-jump-sub">for developers</span>
      </a>
    </nav>

    <section class="op-primary">
      <h2 id="cloud-server">The simple way: a cloud server in three steps</h2>
      <p class="op-fine">
        No terminal, no SSH. You paste one file when you create the server and
        it sets itself up. Any small provider works — Hetzner Cloud and
        DigitalOcean are good, inexpensive picks; the smallest size is plenty.
      </p>

      <ol class="op-steps">
        <li>
          <h3>Start creating a server</h3>
          <p>
            Sign in to your provider and begin creating a new server (a
            "Cloud Server" or "Droplet"). Pick any recent Ubuntu or Debian
            image and the smallest size — leave the page open at the step where
            it offers a <strong>Cloud config</strong> or <strong>User data</strong>{" "}
            field. That field is where the file in step 3 goes.
          </p>
        </li>
        <li>
          <h3>Get a Tailscale key</h3>
          <p>
            palaia joins a <em>tailnet</em> — a small private network of just
            your own devices (via <a href="https://tailscale.com/">Tailscale</a>,
            free for personal use), so your hub is reachable from your phone and
            laptop but never from the open internet. Create a free Tailscale
            account, then open{" "}
            <a href={TAILSCALE_KEYS_URL}>the auth-keys page</a> and generate one
            key (a reusable, ephemeral key works well). Copy it — you paste it
            into the file in the next step.
          </p>
        </li>
        <li>
          <h3>Paste this file, replace the key, create the server</h3>
          <p>
            Copy the file below into the provider's <strong>Cloud config</strong>
            /{" "}<strong>User data</strong> field. Change the one line it marks —
            <code>TAILSCALE_AUTH_KEY="tskey-REPLACE_ME"</code> near the top —
            to the key from step 2. Nothing else needs editing. Then create the
            server.
          </p>
          <div class="op-snippet op-snippet-file">
            <pre><code>{cloudInit}</code></pre>
            <button type="button" class="op-copy" data-copy-target="op-code-cloud-init">Copy</button>
          </div>
          <code id="op-code-cloud-init" class="op-copy-source" hidden>{cloudInit}</code>
          <p class="op-fine">
            A couple of minutes after the server boots it installs everything and
            starts the hub by itself. Then <a href="#open-your-hub">open your hub</a>{" "}
            at its tailnet address. If it does not come up, the server's{" "}
            <code>/var/log/cloud-init-output.log</code> has the full log of what ran.
          </p>
        </li>
      </ol>
    </section>

    <section class="op-existing">
      <h2 id="already-have-a-server">Already have a server? One command over SSH</h2>
      <p>
        The file above only runs on a server's <em>first</em> boot, so pasting it
        into a box that is already running does nothing. For a server you already
        have, SSH in and run this one line — the installer sets up Docker,
        Tailscale, the tailnet-only firewall and the hardened hub, and asks you
        to paste a <a href={TAILSCALE_KEYS_URL}>Tailscale key</a> when it runs:
      </p>
      <div class="op-snippet">
        <pre><code>{installCommand}</code></pre>
        <button type="button" class="op-copy" data-copy-target="op-code-install">Copy</button>
      </div>
      <code id="op-code-install" class="op-copy-source" hidden>{installCommand}</code>
    </section>

    <section class="op-owned">
      <h2 id="your-own-machine">Or a machine you already own</h2>
      <p class="op-fine">The developer options below install the same hub on any of these:</p>
      <ul class="op-machines">
        <li>
          <strong>Raspberry Pi</strong> or another small always-on box — works
          today with 64-bit Raspberry Pi OS and Docker installed, then the
          Docker command below. A flash-and-boot card image that skips even
          those steps is <a href={`${REPO}/issues/280`}>planned and tracked in the open</a>.
        </li>
        <li>
          <strong>Synology NAS</strong> — its Container Manager runs a Compose
          file as a "project"; no terminal on the NAS itself. See the{" "}
          <a href={`${BASE}/install-synology/`}>step-by-step Synology walkthrough</a>.
        </li>
        <li>
          <strong>Mac or Windows</strong> — install{" "}
          <a href="https://www.docker.com/products/docker-desktop/">Docker Desktop</a>{" "}
          once, then the Docker command below is the whole install. (Best for
          trying palaia out — for everyday use a box that stays on wins.)
        </li>
      </ul>
    </section>

    <section class="op-dev">
      <h2 id="for-developers">For developers: Docker &amp; Compose</h2>
      <p class="op-fine">
        Already run containers? Install the hub straight from the image.
      </p>

      {prerelease && (
        <aside class="op-rc">
          <strong>Release candidate.</strong> The commands here still name the{" "}
          <code>:stable</code> image, which is not published until 3.0.0 is final.
          Until then use <code>:beta</code> instead — e.g.{" "}
          <code>ghcr.io/byte5ai/palaia-hub:beta</code>. The cloud-server file and
          the <code>get.palaia.ai</code> one-liner above already target
          <code>:beta</code>, so there is nothing to change there.
        </aside>
      )}

      <div class="op-tabs" role="tablist">
        <input type="radio" name="op-platform" id="op-tab-docker" checked />
        <input type="radio" name="op-platform" id="op-tab-compose" />
        <input type="radio" name="op-platform" id="op-tab-stores" />

        <div class="op-tabbar">
          <label for="op-tab-docker">Docker</label>
          <label for="op-tab-compose">Compose file</label>
          <label for="op-tab-stores">Self-hosting app stores</label>
        </div>

        <section class="op-panel" id="op-panel-docker">
          <h3>One command</h3>
          <p>
            With Docker installed (Docker Desktop on macOS/Windows, or Docker
            Engine on Linux), this is the whole install:
          </p>
          <div class="op-snippet">
            <pre><code>{snippets.dockerRun}</code></pre>
            <button type="button" class="op-copy" data-copy-target="op-code-docker">Copy</button>
          </div>
          <code id="op-code-docker" class="op-copy-source" hidden>{snippets.dockerRun}</code>

          <p class="op-fine">
            Want a script that installs Docker and Tailscale for you and prints the
            address at the end? That is the <a href="#already-have-a-server">one
            command over SSH</a> above — <code>curl … get.palaia.ai | sh</code>.
          </p>
        </section>

        <section class="op-panel" id="op-panel-compose">
          <h3>A file you keep</h3>
          <p>
            Prefer a config file you can edit and check in, or already run other
            containers this way? Clone the repository and start it with Compose:
          </p>
          <div class="op-snippet">
            <pre><code>git clone {REPO}.git
{snippets.compose}</code></pre>
            <button type="button" class="op-copy" data-copy-target="op-code-compose">Copy</button>
          </div>
          <code id="op-code-compose" class="op-copy-source" hidden>git clone {REPO}.git
{snippets.compose}</code>
          <p class="op-fine">
            A ready-to-use <code>docker-compose.yml</code> ships in that repository at{" "}
            <code>v3/deploy/</code> — nothing to write yourself.
          </p>
        </section>

        <section class="op-panel" id="op-panel-stores">
          <h3>Self-hosting app stores</h3>
          <p>
            Packages for these platforms are built and kept current in the
            repository, but none is listed in an official app catalog yet — a
            submission step still to happen, tracked in the open. Until a listing
            goes live, Docker or Compose above install the same image on any of
            them, since they all run containers underneath.
          </p>
          <ul class="op-stores">
            {STORES.map((store) => (
              <li>
                <span class="op-stores-name">{store.name}</span>
                <span class="op-stores-status">not yet listed</span>
                <a href={`${REPO}/tree/main/v3/deploy/stores/${store.dir}`}>package source</a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>

    <h2 id="open-your-hub">Then open your hub</h2>
    <p>
      On a cloud or SSH setup, open <code>http://&lt;your-tailnet-address&gt;:8420/</code>{" "}
      from any device on your tailnet (the setup prints the address when it
      finishes). On a machine on your own network, open <code>http://palaia.local</code>
      — or, if that address does not resolve yet (some setups need one network
      flag; see <a href={`${BASE}/install/#finding-it-on-your-network-palaialocal`}>Install it</a>{" "}
      for the one-line fix), the <code>http://&lt;host&gt;:8420</code> address printed
      to the container's own log, which always works.
    </p>

    <h2>The wizard takes over</h2>
    <p>
      From there a short setup wizard runs in the browser: an administrator
      sign-in, your first memory, and connecting the first AI tool you use — no
      file editing, no extra commands. See{" "}
      <a href={`${BASE}/first-shared-memory/`}>Your first shared memory</a> for what that
      looks like end to end, or <a href={`${BASE}/install/`}>Install it</a> for the longer
      version of everything on this page.
    </p>
  </div>

  <script>
    // Progressive enhancement only: the commands above are plain, selectable
    // text without this script — copy buttons are a convenience, not a
    // requirement to finish setup.
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-target]")) {
      button.addEventListener("click", async () => {
        const source = document.getElementById(button.dataset.copyTarget ?? "");
        if (!source?.textContent) return;
        try {
          await navigator.clipboard.writeText(source.textContent);
          const original = button.textContent;
          button.textContent = "Copied";
          setTimeout(() => {
            button.textContent = original;
          }, 1500);
        } catch {
          // clipboard access can be refused (older browser, insecure
          // context) — the text is still right there, selectable by hand.
        }
      });
    }
  </script>
</StarlightPage>

<style>
  /* Phone-friendly by construction: nothing here sets a fixed pixel width,
     every code block scrolls inside its own box (never the page), and the
     tab bar wraps instead of forcing a wider viewport — SPEC-504
     deliverable #1's "no horizontal scroll on phones". */
  .op {
    max-width: 46rem;
  }
  .op-lede {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }

  .op section {
    margin-block: 2.5rem;
  }

  /* Jump nav: the install paths in a row, each anchoring to its section, so a
     reader picks a path without scrolling the whole page first. Auto-fit grid
     — a row on desktop, wrapping to a stack on a phone (no fixed pixel width,
     so no horizontal scroll). */
  .op-jump {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.6rem;
    margin-block: 1.5rem 2.5rem;
  }
  .op-jump a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 2.4rem 0.9rem 1.1rem;
    /* Cyan-tinted border even at rest so the tiles read as interactive
       choices, not decoration, against the near-black page. */
    border: 1px solid rgba(0, 159, 227, 0.4);
    border-radius: 0.7rem;
    background: var(--sl-color-gray-6);
    text-decoration: none;
    color: var(--sl-color-white);
    transition: border-color 0.15s ease, background 0.15s ease,
      transform 0.15s ease, box-shadow 0.15s ease;
  }
  /* An arrow that says "go here" — the affordance that marks the tile as a
     jump, and slides on hover. */
  .op-jump a::after {
    content: "→";
    position: absolute;
    top: 50%;
    right: 1rem;
    transform: translateY(-50%);
    color: var(--sl-color-accent);
    font-weight: 700;
    font-size: 1.1rem;
    transition: transform 0.15s ease;
  }
  .op-jump a:hover,
  .op-jump a:focus-visible {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 159, 227, 0.18);
  }
  .op-jump a:hover::after,
  .op-jump a:focus-visible::after {
    transform: translateY(-50%) translateX(4px);
  }
  .op-jump-title {
    font-weight: 700;
    /* Link-cyan, so the title itself signals the tile is clickable. */
    color: var(--sl-color-accent-high);
  }
  .op-jump-sub {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }

  /* Anchor targets clear Starlight's sticky header when jumped to. */
  .op [id] {
    scroll-margin-top: 5rem;
  }

  /* Primary path: the numbered three steps. */
  .op-steps {
    list-style: none;
    counter-reset: op-step;
    padding: 0;
    display: grid;
    gap: 1rem;
    margin-block: 1.5rem;
  }
  .op-steps > li {
    counter-increment: op-step;
    position: relative;
    padding: 1rem 1rem 1rem 3.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-gray-6);
  }
  .op-steps > li::before {
    content: counter(op-step);
    position: absolute;
    left: 1rem;
    top: 1rem;
    width: 1.9rem;
    height: 1.9rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 700;
    font-size: var(--sl-text-sm);
  }
  .op-steps > li h3 {
    margin-top: 0;
    font-size: var(--sl-text-base);
  }

  /* Release-candidate channel note (only rendered while v3/VERSION is a
     pre-release). */
  .op-rc {
    border: 1px solid var(--sl-color-accent);
    border-left-width: 4px;
    border-radius: 0.4rem;
    padding: 0.75rem 1rem;
    margin-block: 1rem;
    background: var(--sl-color-accent-low);
    font-size: var(--sl-text-sm);
  }

  .op-tabs {
    margin-block: 1.5rem;
  }
  .op-tabs input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .op-tabbar {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    margin-bottom: 1.5rem;
  }
  /* Every label carries the same transparent 2px underline, so switching a
     tab active only changes its colour — never its box height. (The old rule
     added the border to the active label alone, which nudged its text ~2px
     up and made "Docker" look superscripted next to its neighbours.) */
  .op-tabbar label {
    cursor: pointer;
    padding: 0.5rem 0.9rem;
    border-radius: 0.4rem 0.4rem 0 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    user-select: none;
  }
  .op-tabbar label:hover {
    color: var(--sl-color-white);
  }
  .op-panel {
    display: none;
    margin-block: 0;
  }
  #op-tab-docker:checked ~ .op-tabbar label[for="op-tab-docker"],
  #op-tab-compose:checked ~ .op-tabbar label[for="op-tab-compose"],
  #op-tab-stores:checked ~ .op-tabbar label[for="op-tab-stores"] {
    color: var(--sl-color-accent-high);
    border-bottom-color: var(--sl-color-accent);
  }
  #op-tab-docker:checked ~ #op-panel-docker,
  #op-tab-compose:checked ~ #op-panel-compose,
  #op-tab-stores:checked ~ #op-panel-stores {
    display: block;
  }

  .op-snippet {
    position: relative;
    max-width: 100%;
    overflow-x: auto;
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    padding: 1rem 5.5rem 1rem 1rem;
  }
  .op-snippet pre {
    margin: 0;
    white-space: pre;
  }
  .op-copy {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-size: var(--sl-text-xs);
    padding: 0.3rem 0.6rem;
    border-radius: 0.3rem;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    cursor: pointer;
  }
  .op-copy:hover {
    background: var(--sl-color-gray-5);
  }
  .op-copy-source {
    display: none;
  }
  .op-fine {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  /* The cloud-init file is much longer than the other snippets — scrolls
     inside its own fixed-height box instead of stretching the page. */
  .op-snippet-file {
    max-height: 16rem;
    overflow-y: auto;
  }

  .op-stores {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .op-stores li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.4rem;
  }
  .op-stores-name {
    font-weight: 600;
    min-width: 8rem;
  }
  .op-stores-status {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .op-machines {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .op-machines li {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.4rem;
  }
</style>
