# The scaffold (SPEC-001) pins a pre-release TypeScript (~6.0.2) ahead of
# several tools' peer ranges (typescript-eslint, openapi-typescript,
# @ladle/react's vite plugin). Nothing here is actually incompatible at
# runtime — npm's strict peer resolution is just stricter than the real
# constraint — so `npm ci`/`npm install` stay usable without a manual
# --legacy-peer-deps flag on every machine and in CI.
legacy-peer-deps=true
