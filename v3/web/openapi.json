  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness + component readiness. No dependencies in this SPEC.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/info": {
      "get": {
        "summary": "Info",
        "description": "Version, operating mode, uptime, and how the owner signs in.\n\n``sign_in`` is non-secret (no client id, no allow-list) and is what\nthe dashboard's settings section (SPEC-204 deliverable #4) reads to\nshow \"Sign in with GitHub\" / a configured provider's name / the\nlocal password, in plain language. SPEC-401 adds two equally\nnon-secret fields to it: whether signing in is *required* on this\nhub, and where the one door is \u2014 which is what lets the dashboard\nshow a sign-in prompt (and a sign-out button) without first making a\ncall that fails.",
        "operationId": "info_api_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Info Api Info Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/update/check": {
      "get": {
        "summary": "Update Check",
        "description": "\"Up to date\" / \"Update available\" / \"could not check\" \u2014 never an\nerror page (this hub might simply be offline). See\n:func:`palaia_hub.update.check_for_update` for what each state\nmeans and how the remote version is read.",
        "operationId": "update_check_api_update_check_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Update Check Api Update Check Get"
                }
              }
            }
          }
        }
      }
    },
