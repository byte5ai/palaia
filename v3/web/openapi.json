                  "type": "object",
                  "title": "Response Info Api Info Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/vaults/{vault_key}/inbox_status": {
      "get": {
        "summary": "Inbox Status",
        "operationId": "inbox_status_api_vaults__vault_key__inbox_status_get",
