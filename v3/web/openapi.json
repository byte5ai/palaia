    "/api/events": {
      "get": {
        "summary": "Events",
        "description": "Server-Sent Events stream carrying the public event envelope.\n\nEvery connection first receives an immediate ``health`` snapshot\n(so a freshly opened dashboard tab does not wait out the first\ntick), then whatever the bus publishes afterwards.",
        "operationId": "events_api_events_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
